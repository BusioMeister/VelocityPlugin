new file mode 100644
index 0000000..9eedb87
--- /dev/null
+++ b/proxy/src/test/java/com/velocitypowered/proxy/connection/backend/SeamConfigTraceTest.java
@@ -0,0 +1,37 @@
+package com.velocitypowered.proxy.connection.backend;
+
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class SeamConfigTraceTest {
+  @Test
+  void orderedRegistriesAndTagsMustMatchWithoutConsumingBuffers() {
+    var first = trace(false, false);
+    var same = trace(false, false);
+    assertTrue(first.matches(same));
+    assertFalse(first.matches(trace(true, false)));
+    assertFalse(first.matches(trace(false, true)));
+    assertFalse(first.matches(null));
+    assertFalse(new SeamConfigTrace().finish().matches(new SeamConfigTrace().finish()));
+  }
+
+  private static SeamConfigTrace.Result trace(boolean reverse, boolean unsupported) {
+    var trace = new SeamConfigTrace();
+    var data = Unpooled.buffer().writeByte(1).writeByte(2);
+    try {
+      data.readerIndex(1);
+      trace.record(reverse ? "tags" : "registry", data);
+      trace.record(reverse ? "registry" : "tags", data);
+      assertTrue(data.readerIndex() == 1);
+      if (unsupported) {
+        trace.unsupported();
+      }
+      return trace.finish();
+    } finally {
+      data.release();
+    }
+  }
+}

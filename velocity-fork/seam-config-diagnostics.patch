+
+package com.velocitypowered.proxy.connection.backend;
+
+import io.netty.buffer.ByteBuf;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HexFormat;
+
+/** Records bounded, ordered configuration evidence without consuming packet bytes. */
+final class SeamConfigTrace {
+  private static final int MAX_BYTES = 4 * 1024 * 1024;
+  private final MessageDigest digest = sha256();
+  private int bytes;
+  private int registries;
+  private boolean unsupported;
+
+  void record(String type, ByteBuf data) {
+    int length = data.readableBytes();
+    if (unsupported || length > MAX_BYTES - bytes) {
+      unsupported = true;
+      return;
+    }
+    bytes += length;
+    if (type.equals("registry")) {
+      registries++;
+    }
+    digest.update(type.getBytes(StandardCharsets.US_ASCII));
+    digest.update((byte) 0);
+    digest.update(ByteBuffer.allocate(4).putInt(length).array());
+    for (ByteBuffer segment : data.nioBuffers(data.readerIndex(), length)) {
+      digest.update(segment);
+    }
+  }
+
+  void unsupported() {
+    unsupported = true;
+  }
+
+  Result finish() {
+    return new Result(HexFormat.of().formatHex(digest.digest()), registries, bytes, unsupported);
+  }
+
+  record Result(String hash, int registries, int bytes, boolean unsupported) {
+    boolean matches(Result other) {
+      return other != null && !unsupported && !other.unsupported && registries > 0
+          && registries == other.registries && bytes == other.bytes && hash.equals(other.hash);
+    }
+  }
+
+  private static MessageDigest sha256() {
+    try {
+      return MessageDigest.getInstance("SHA-256");
+    } catch (NoSuchAlgorithmException unavailable) {
+      throw new IllegalStateException(unavailable);
+    }
+  }
+}

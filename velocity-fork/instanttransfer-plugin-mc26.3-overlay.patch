+package fr.cupcode.instanttransfer.switching;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class PlayerLoadedHandshakeTest {
+    @Test
+    void waitsForBothTheDestinationChunkAndTheCorrectTeleportAck() {
+        SwitchState state = new SwitchState();
+        state.armGuard(100);
+        state.awaitArrivalAck(6);
+        state.markDestinationChunkDelivered();
+        state.acknowledgeArrival(5);
+        assertFalse(state.canNotifyPlayerLoaded());
+        state.acknowledgeArrival(6);
+        assertTrue(state.canNotifyPlayerLoaded());
+        state.markPlayerLoadedSent();
+        assertFalse(state.canNotifyPlayerLoaded());
+    }
+
+    @Test
+    void anAckBeforeTheChunkAlsoWorksAndDoesNotLeakIntoTheNextSwitch() {
+        SwitchState state = new SwitchState();
+        state.armGuard(100);
+        state.awaitArrivalAck(7);
+        state.acknowledgeArrival(7);
+        assertFalse(state.canNotifyPlayerLoaded());
+        state.markDestinationChunkDelivered();
+        assertTrue(state.canNotifyPlayerLoaded());
+        state.armGuard(200);
+        state.markDestinationChunkDelivered();
+        assertFalse(state.canNotifyPlayerLoaded());
+    }
+}

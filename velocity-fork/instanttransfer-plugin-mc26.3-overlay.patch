+    /** PacketEvents 2.14 Velocity has already consumed the packet type before listeners run. */
+    static boolean rewriteSelfId(ByteBuf buf, SwitchState state) {
+        int start = buf.readerIndex();
+        int[] id = varIntSpan(buf, start);
+        if (id == null || readVarInt(buf, start) != state.backendEntityId()) return false;
+        byte[] original = snapshot(buf, start, buf.writerIndex());
+        int oldLength = id[1] - start;
+        try {
+            int newLength = 1;
+            for (int value = state.clientEntityId(); (value & ~0x7F) != 0; value >>>= 7) newLength++;
+            buf.ensureWritable(Math.max(0, newLength - oldLength));
+            buf.writerIndex(start);
+            writeVarInt(buf, state.clientEntityId());
+            buf.writeBytes(original, oldLength, original.length - oldLength);
+            return true;
+        } catch (RuntimeException error) {
+            buf.setBytes(start, original);
+            buf.writerIndex(start + original.length);
+            return false;
+        }
+    }
